{
  "name": "@lizzie-teo/conjure-ui",
  "version": "0.2.0",
  "description": "White-label AI chat component library for retail, pharmacy, grocery, travel and insurance chatbots",
  "author": "Lizzie Teo",
  "license": "MIT",
  "keywords": [
    "react",
    "component-library",
    "design-system",
    "ai-chat",
    "chatbot",
    "chat-ui",
    "white-label",
    "tailwindcss",
    "shadcn",
    "design-tokens"
  ],
  "homepage": "https://lizzie-teo.github.io/conjure-ui/",
  "bugs": {
    "url": "https://github.com/lizzie-teo/conjure-ui/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./primitives": {
      "types": "./dist/components/primitives/index.d.ts",
      "import": "./dist/primitives.js"
    },
    "./core": {
      "types": "./dist/components/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./layouts": {
      "types": "./dist/components/layouts/index.d.ts",
      "import": "./dist/layouts.js"
    },
    "./styles": "./app/globals.css",
    "./theme": "./app/theme.css"
  },
  "files": [
    "dist",
    "app/globals.css",
    "app/theme.css",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lizzie-teo/conjure-ui.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite",
    "next": "next dev",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/fix-dts-extensions.mjs && node scripts/write-dist-package-type.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "build:next": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "test": "vitest run --project=storybook",
    "test:consumer": "node scripts/consumer-smoke.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.101.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-themes": "^10.4.2",
    "@storybook/addon-vitest": "^10.4.2",
    "@storybook/nextjs-vite": "^10.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "chromatic": "^17.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "eslint-plugin-storybook": "^10.4.2",
    "next": "16.2.7",
    "playwright": "^1.60.0",
    "publint": "^0.3.22",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "storybook": "^10.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
