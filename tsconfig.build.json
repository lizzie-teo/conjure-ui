{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationDir": "dist",
    "outDir": "dist",
    "moduleResolution": "bundler",
    // Vite wipes dist via emptyOutDir; an incremental cache would then let tsc
    // decide it has nothing to emit and publish a package with no .d.ts files.
    "incremental": false,
    "plugins": []
  },
  "include": [
    "svg.d.ts",
    "index.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.stories.tsx",
    "demo/**/*",
    "app/**/*"
  ]
}
